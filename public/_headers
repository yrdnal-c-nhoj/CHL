/*
  Immutable hashed assets (JS/CSS/fonts/images/media).
  Hashed filenames guarantee content addressability; cache forever.
/
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*.mp4
  Content-Type: video/mp4

/assets/images/*.webm
  Content-Type: video/webm

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
