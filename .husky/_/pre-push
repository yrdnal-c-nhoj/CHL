#!/bin/sh
# Pre-push hook: upload all LFS objects before allowing push.
# Prevents GH008 errors when pushing commits with new LFS-tracked files.

echo "[husky] Uploading Git LFS objects..."
git lfs push --all origin "$1"

if [ $? -ne 0 ]; then
  echo "[husky] LFS upload failed. Push aborted."
  exit 1
fi

echo "[husky] LFS objects uploaded successfully."

# Delegate to git lfs pre-push for standard validation
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs pre-push "$@"