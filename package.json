{
  "name": "BorrowedTime",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "node -e \"require('fs').mkdirSync('src/assets/thumbnails',{recursive:true})\" && npx playwright install chromium",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:clocks": "node scripts/verify-all-clocks.js",
    "verify:clocks:changed": "node scripts/verify-all-clocks.js --changed",
    "conform": "node scripts/conform.js",
    "new-clock": "node scripts/new-clock.js",
    "screencaps": "tsx scripts/screencaps/capture.ts",
    "screencaps:optimize": "tsx scripts/screencaps/capture.ts --optimize",
    "prepare": "husky || true",
    "type-check": "tsc --noEmit -p tsconfig.ci.json",
    "check": "npm run type-check && npm run lint && npm run format:check && npm run test:run && npm run verify:clocks:changed && npm run build",
    "check:ci": "npm run type-check && npm run lint && npm run format:check && npm run test:run && npm run verify:clocks && npm run build",
    "status": "npm run verify:clocks && npm run type-check"
  },
  "dependencies": {
    "@fontsource/roboto-mono": "^5.2.8",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "axios": "^1.13.2",
    "d3": "^7.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "three": "^0.180.0"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@mdx-js/rollup": "^3.1.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^15.5.0",
    "playwright": "^1.52.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.6",
    "vite-plugin-compression": "0.5.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "basic-ftp": "^5.3.0",
    "lodash": "^4.18.1",
    "three-mesh-bvh": "0.8.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "sh -c 'npm run type-check'"
    ],
    "*.{js,json,css,md,mdx}": [
      "prettier --write"
    ],
    "src/pages/**/Clock.tsx": [
      "sh -c 'npm run verify:clocks:changed'"
    ]
  }
}
